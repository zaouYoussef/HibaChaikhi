# PostgreSQL (local ou Railway)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/caravane_medicale?schema=public"
JWT_SECRET="changez-moi-en-production-une-chaine-longue-et-aleatoire"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Optionnel: source officielle data.gov.ma pour lookup code-barres
