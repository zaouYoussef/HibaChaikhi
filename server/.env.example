# Optionnel: API Vision IA (Gemini) pour extraction image robuste
VISION_API_KEY=""
VISION_MODEL="gemini-1.5-flash"
# Optionnel: endpoint custom si passerelle proxy
VISION_API_URL=""
# Debug scan image (logs détaillés backend: 1=on, 0=off)
DEBUG_SCAN="0"

